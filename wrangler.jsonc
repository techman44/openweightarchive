{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "openweightarchive",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": ["nodejs_compat"],
  // Astro's Cloudflare Vite plugin supplies the built assets directory and entrypoint.
  "assets": { "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "OWA_DB",
      "database_name": "owa-cms",
      // Placeholder: replace with the existing D1 database UUID before deployment.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [{ "binding": "OWA_MEDIA", "bucket_name": "owa-media" }],
  "vars": { "ADMIN_USERNAME": "archivist" },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
