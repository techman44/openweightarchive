{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "openweightarchive-v2",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "routes": [],
  "assets": {
    "binding": "ASSETS"
  },
  "vars": {
    "ADMIN_USERNAME": "archivist"
  },
  "observability": {
    "enabled": true
  }
}
