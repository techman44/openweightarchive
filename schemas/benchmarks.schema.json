{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "model": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "provenance": {
      "type": "string",
      "enum": [
        "fixture",
        "claim",
        "verified",
        "partial"
      ]
    },
    "run": {
      "type": "object",
      "properties": {
        "arm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "suite": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "config": {
          "type": "object",
          "properties": {
            "thinking": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "max_gen_toks": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1048576
                },
                {
                  "type": "null"
                }
              ]
            },
            "temperature": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "thinking",
            "max_gen_toks",
            "temperature"
          ],
          "additionalProperties": false
        },
        "metrics": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "score": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "n": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "stderr": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "unit": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "verified",
                  "partial",
                  "re-running",
                  "queued",
                  "scheduled",
                  "pass"
                ]
              },
              "note": {
                "type": "string"
              }
            },
            "required": [
              "score",
              "n"
            ],
            "additionalProperties": false
          }
        },
        "evidence": {
          "type": "object",
          "properties": {
            "engine": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "image": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "kv": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "context": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "source": {
              "type": "string"
            },
            "raw": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          },
          "required": [
            "engine",
            "image",
            "kv",
            "context",
            "source",
            "raw",
            "note"
          ],
          "additionalProperties": false
        },
        "ts": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "hardware": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          ]
        }
      },
      "required": [
        "arm",
        "suite",
        "config",
        "metrics",
        "ts",
        "hardware"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "slug",
    "model",
    "provenance",
    "run"
  ],
  "additionalProperties": false
}
