---
import '@fontsource/archivo/400.css';
import '@fontsource/archivo/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
interface Props { title: string; description?: string; noindex?: boolean; }
const { title, description = 'Open-weight model measurements and their evidence.', noindex = import.meta.env.OWA_PREVIEW === '1' } = Astro.props;
const path = Astro.url.pathname;
const links = [['/', 'Register'], ['/benchmarks', 'Models'], ['/submit', 'Submissions'], ['/blog', 'Journal'], ['/admin', 'Admin']];
---
<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} /><meta name="theme-color" content="#16181c" />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={new URL(path, Astro.site)} /><title>{title} · OpenWeightArchive</title>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <a class="wordmark" href="/" aria-label="OpenWeightArchive home">OWA</a>
    <p class="rail-label">OpenWeightArchive<br />Model measurement index</p>
    <nav class="nav" aria-label="Main navigation">{links.map(([href, label]) => <a href={href} aria-current={(href === '/' ? path === '/' : path.startsWith(href) || href === '/benchmarks' && path.startsWith('/models/')) ? 'page' : undefined}>{label}</a>)}</nav>
    <div class="telemetry"><p>Archive telemetry</p><dl><div><dt>Arm count</dt><dd>02 measured</dd></div><div><dt>Last ingest</dt><dd>2026-10-21</dd></div><div><dt>ct-bench</dt><dd>Snapshot</dd></div></dl><span>Preview / partial coverage</span></div>
  </header>
  <div class="shell"><main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer"><p>OpenWeightArchive / Sydney, Australia</p><nav aria-label="Footer"><a href="/blog/how-we-record-a-score">Recording method</a><a href="/submit">Submit evidence</a></nav></footer>
  </div>
</body>
</html>
