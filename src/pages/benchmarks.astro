---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
const models = await getCollection('models');
---
<Layout title="Models"><header class="page-intro"><h1>Models</h1><p class="muted">Measured weights. Engine arms and configuration remain attached to each result.</p></header><ul class="model-list">{models.map(({data: model}) => <li><a href={`/models/${model.slug}`}>{model.name}</a><p>{model.summary}</p><span class="status">partial / 2 engine arms</span></li>)}</ul><p class="help">Upcoming models are listed in the <a href="/#queue-title">evaluation queue</a>; queued models have no measured scores.</p></Layout>
