---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Register from '../components/Register.astro';
import { registerRows } from '../../lib/register';
const [models, benchmarks] = await Promise.all([getCollection('models'), getCollection('benchmarks')]);
const rows = registerRows(benchmarks.map(entry => entry.data), models.map(entry => entry.data));
const fastest = Math.max(...rows.filter(row => row.unit === 'tok/s' && row.score !== null).map(row => row.score!));
const metrics = [
  { value: String(models.length).padStart(2, '0'), label: 'Models tracked', note: '2 measured engine arms' },
  { value: String(benchmarks.length).padStart(2, '0'), label: 'Benchmark runs', note: 'Archived suite records' },
  { value: '00', label: 'Verified submissions', note: 'Community intake / none' },
  { value: fastest.toFixed(1), label: 'Fastest tok/s', note: 'Structured / median of 3' },
  { value: '—', label: 'HLE frontier', note: '2,158q / nightly scheduled' },
];
const queue = ['TensorFold 512K', 'Qwen3.8-27B NVFP4', 'Muse Glimmer 30B', 'Nemotron 3.5 Lightning', 'Nemotron 3.5 Bolt', 'Nemotron 3.5 SuperVL', 'GLM-5.3-Flash', 'gpt-oss-120b', 'Qwen3.5-35B-A3B'];
---
<Layout title="Register">
  <h1 class="sr-only">Model measurement register</h1>
  <section class="kpi-strip" aria-label="Collection metrics">{metrics.map(metric => <div class="kpi"><span class="kpi-value">{metric.value}</span><span class="kpi-label">{metric.label}</span><span class="kpi-note">{metric.note}</span></div>)}</section>
  <section id="register" class="register-section" aria-labelledby="register-title">
    <div class="register-heading"><h2 id="register-title">Register</h2><span class="mono muted">ct-bench / snapshot 2026-10-21</span></div>
    <p class="notice">Operator-verified measurements, not independent replication. Classics: partial coverage; coding and ARC re-running at 8,192 tokens. Speed summaries supplied by operator; source logs linked where available.</p>
    <Register rows={rows} />
  </section>
  <section class="section" aria-labelledby="queue-title"><div class="register-heading"><h2 id="queue-title">Evaluation queue</h2><span class="muted">No scores until completed</span></div><ul class="queue-list">{queue.map(name => <li><span>{name}</span><span class="status">queued</span><span class="mono muted">—</span></li>)}</ul>
  <p class="help">HLE / 2,158 questions / text-only. Nightly schedule begins 21 October; no completed frontier score published.</p></section>
</Layout>
