---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
export async function getStaticPaths() { return (await getCollection('posts')).map((post) => ({ params: { slug: post.id }, props: { post } })); }
interface Props { post: CollectionEntry<'posts'>; }
const { post } = Astro.props;
const { Content } = await render(post);
---
<Layout title={post.data.title} description={post.data.description}><article class="reading"><header class="page-intro"><a class="text-link" href="/blog">← The journal</a><p class="eyebrow">{post.data.category}</p><h1>{post.data.title}</h1><p class="lead">{post.data.description}</p><p class="help">{post.data.author} · <time datetime={post.data.published}>{post.data.published}</time></p></header><div class="prose"><Content /></div></article></Layout>
